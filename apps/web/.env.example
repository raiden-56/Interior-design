# Copy to apps/web/.env.local

# Where the FastAPI backend is reachable from the browser. Leave as-is for
# local development; point at your deployed API in production.
NEXT_PUBLIC_API_BASE=http://localhost:8000/api/v1

# --- Authentication ---------------------------------------------------------
# Signing key for session cookies and share links. MUST be set in production:
# without it the app falls back to a well-known development secret.
AUTH_SECRET=change-me-to-a-long-random-string

# The single account that can sign in. Change both before deploying.
AUTH_EMAIL=ganeshmesta1234@gmail.com
AUTH_PASSWORD=Ganesh@123
AUTH_NAME=Ganesh Mesta

# --- Storage service --------------------------------------------------------
# Where the FastAPI project store lives. The browser never talks to it
# directly: requests go through /api/backend, which adds API_TOKEN server-side.
API_ORIGIN=http://localhost:8000/api/v1
# Must match API_TOKEN in backend/.env. Leave empty for local development.
API_TOKEN=
