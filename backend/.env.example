# Copy to backend/.env (or export in your shell) before starting uvicorn.

# SQLite by default. For Postgres: postgresql+psycopg://user:pass@host:5432/interior
DATABASE_URL=sqlite:///./interior.db

# Browser origins allowed to call the API (comma separated).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional: enables the Claude-backed AI planner. Leave empty to keep the
# built-in rule-based assistant (works fully offline).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Shared secret with the web app (its API_TOKEN). When set, every project and
# AI route requires the X-API-Token header, so only the app can reach them.
# Leave empty for local development.
API_TOKEN=
